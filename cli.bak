<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WAV to WebSocket Stream</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #1a2a6c, #b21f1f, #fdbb2d);
            color: white;
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .container {
            background: rgba(0, 0, 0, 0.7);
            border-radius: 15px;
            padding: 30px;
            width: 90%;
            max-width: 800px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(10px);
        }
        
        h1 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 2.2rem;
            color: #fdbb2d;
            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
        }
        
        .card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }
        
        .card-title {
            font-size: 1.3rem;
            margin-bottom: 15px;
            color: #fdbb2d;
            display: flex;
            align-items: center;
        }
        
        .card-title i {
            margin-right: 10px;
            font-size: 1.5rem;
        }
        
        .settings {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        
        @media (max-width: 600px) {
            .settings {
                grid-template-columns: 1fr;
            }
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        
        input, select {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #444;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 1rem;
        }
        
        input:focus, select:focus {
            outline: none;
            border-color: #fdbb2d;
            box-shadow: 0 0 0 2px rgba(253, 187, 45, 0.3);
        }
        
        .file-upload {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px;
            border: 2px dashed #fdbb2d;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .file-upload:hover {
            background: rgba(253, 187, 45, 0.1);
        }
        
        .file-upload i {
            font-size: 3rem;
            margin-bottom: 15px;
            color: #fdbb2d;
        }
        
        .file-info {
            margin-top: 15px;
            font-size: 0.9rem;
            color: #aaa;
        }
        
        .controls {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 25px 0;
        }
        
        button {
            padding: 14px 30px;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        button i {
            margin-right: 8px;
        }
        
        #connectBtn {
            background: #3498db;
            color: white;
        }
        
        #connectBtn:hover {
            background: #2980b9;
            transform: translateY(-2px);
        }
        
        #sendBtn {
            background: #2ecc71;
            color: white;
        }
        
        #sendBtn:hover {
            background: #27ae60;
            transform: translateY(-2px);
        }
        
        #stopBtn {
            background: #e74c3c;
            color: white;
        }
        
        #stopBtn:hover {
            background: #c0392b;
            transform: translateY(-2px);
        }
        
        button:disabled {
            background: #7f8c8d;
            cursor: not-allowed;
            transform: none;
        }
        
        .status {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 25px;
        }
        
        .status-item {
            flex: 1;
            min-width: 150px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }
        
        .status-label {
            font-size: 0.9rem;
            color: #aaa;
            margin-bottom: 5px;
        }
        
        .status-value {
            font-size: 1.3rem;
            font-weight: 600;
            color: #fdbb2d;
        }
        
        .result-container {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 10px;
            padding: 20px;
            margin-top: 25px;
        }
        
        .result-title {
            font-size: 1.3rem;
            margin-bottom: 15px;
            color: #fdbb2d;
            display: flex;
            align-items: center;
        }
        
        .result-content {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 8px;
            padding: 15px;
            min-height: 150px;
            max-height: 300px;
            overflow-y: auto;
            font-family: monospace;
            white-space: pre-wrap;
        }
        
        .progress-container {
            margin-top: 20px;
        }
        
        .progress-bar {
            height: 10px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 5px;
            overflow: hidden;
        }
        
        .progress {
            height: 100%;
            background: #2ecc71;
            width: 0%;
            transition: width 0.3s;
        }
        
        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            font-size: 0.9rem;
        }
        
        .log-container {
            margin-top: 25px;
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 15px;
            background: rgba(0, 0, 0, 0.3);
        }
        
        .log-entry {
            padding: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 0.9rem;
        }
        
        .log-entry:last-child {
            border-bottom: none;
        }
        
        .success {
            color: #2ecc71;
        }
        
        .error {
            color: #e74c3c;
        }
        
        .info {
            color: #3498db;
        }
        
        .warning {
            color: #f39c12;
        }
        
        .connection-status {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            padding: 15px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.1);
        }
        
        .status-indicator {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            margin-right: 15px;
        }
        
        .status-connected {
            background: #2ecc71;
            box-shadow: 0 0 10px #2ecc71;
        }
        
        .status-disconnected {
            background: #e74c3c;
        }
        
        .status-connecting {
            background: #f39c12;
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <h1><i class="fas fa-wave-square"></i> WAV文件转WebSocket流</h1>
        
        <div class="connection-status">
            <div class="status-indicator status-disconnected" id="statusIndicator"></div>
            <div id="connectionStatus">未连接</div>
        </div>
        
        <div class="card">
            <div class="card-title"><i class="fas fa-cog"></i> 服务器设置</div>
            <div class="settings">
                <div class="form-group">
                    <label for="serverUrl"><i class="fas fa-link"></i> WebSocket 服务器地址</label>
                    <input type="text" id="serverUrl" value="ws://localhost:8765/ws/audio" placeholder="输入WebSocket服务器地址">
                </div>
                
                <div class="form-group">
                    <label for="chunkSize"><i class="fas fa-chart-bar"></i> 数据块大小 (字节)</label>
                    <select id="chunkSize">
                        <option value="1024">1024</option>
                        <option value="2048" selected>2048</option>
                        <option value="4096">4096</option>
                        <option value="8192">8192</option>
                    </select>
                </div>
            </div>
        </div>
        
        <div class="card">
            <div class="card-title"><i class="fas fa-file-audio"></i> WAV文件选择</div>
            <div class="file-upload" id="fileDropArea">
                <i class="fas fa-cloud-upload-alt"></i>
                <p>点击或拖放WAV文件到这里</p>
                <p class="file-info">(16kHz采样率，单声道，16位PCM格式)</p>
                <input type="file" id="fileInput" accept=".wav" hidden>
            </div>
            <div id="fileInfo" class="file-info" style="text-align: center; margin-top: 15px;"></div>
        </div>
        
        <div class="controls">
            <button id="connectBtn"><i class="fas fa-plug"></i> 连接服务器</button>
            <button id="sendBtn" disabled><i class="fas fa-paper-plane"></i> 发送文件</button>
            <button id="stopBtn" disabled><i class="fas fa-stop"></i> 停止发送</button>
        </div>
        
        <div class="status">
            <div class="status-item">
                <div class="status-label">连接状态</div>
                <div class="status-value" id="connectionStatusValue">未连接</div>
            </div>
            <div class="status-item">
                <div class="status-label">文件大小</div>
                <div class="status-value" id="fileSize">0 KB</div>
            </div>
            <div class="status-item">
                <div class="status-label">发送进度</div>
                <div class="status-value" id="progressValue">0%</div>
            </div>
            <div class="status-item">
                <div class="status-label">数据包</div>
                <div class="status-value" id="packetCount">0</div>
            </div>
        </div>
        
        <div class="progress-container">
            <div class="progress-bar">
                <div class="progress" id="progressBar"></div>
            </div>
            <div class="progress-info">
                <span>已发送: <span id="sentSize">0 KB</span></span>
                <span>剩余: <span id="remainingSize">0 KB</span></span>
            </div>
        </div>
        
        <div class="result-container">
            <div class="result-title"><i class="fas fa-server"></i> 服务器响应</div>
            <div class="result-content" id="serverResponse">等待服务器响应...</div>
        </div>
        
        <div class="log-container" id="logContainer">
            <div class="log-entry info">系统已就绪，请选择WAV文件并连接服务器</div>
        </div>
    </div>

    <script>
        // 全局变量
        let websocket = null;
        let audioFile = null;
        let fileReader = null;
        let isSending = false;
        let packetCounter = 0;
        let fileSize = 0;
        let bytesSent = 0;
        let chunkSize = 2048;
        let fileHeaderSize = 44; // WAV文件头大小
        
        // DOM元素
        const fileDropArea = document.getElementById('fileDropArea');
        const fileInput = document.getElementById('fileInput');
        const fileInfo = document.getElementById('fileInfo');
        const connectBtn = document.getElementById('connectBtn');
        const sendBtn = document.getElementById('sendBtn');
        const stopBtn = document.getElementById('stopBtn');
        const serverUrlInput = document.getElementById('serverUrl');
        const chunkSizeSelect = document.getElementById('chunkSize');
        const connectionStatus = document.getElementById('connectionStatus');
        const connectionStatusValue = document.getElementById('connectionStatusValue');
        const fileSizeDisplay = document.getElementById('fileSize');
        const progressValue = document.getElementById('progressValue');
        const progressBar = document.getElementById('progressBar');
        const sentSize = document.getElementById('sentSize');
        const remainingSize = document.getElementById('remainingSize');
        const packetCount = document.getElementById('packetCount');
        const serverResponse = document.getElementById('serverResponse');
        const logContainer = document.getElementById('logContainer');
        const statusIndicator = document.getElementById('statusIndicator');

        // 初始化
        function init() {
            // 文件选择事件
            fileDropArea.addEventListener('click', () => {
                fileInput.click();
            });
            
            fileInput.addEventListener('change', handleFileSelect);
            
            // 拖放事件
            fileDropArea.addEventListener('dragover', (e) => {
                e.preventDefault();
                fileDropArea.style.borderColor = '#2ecc71';
                fileDropArea.style.backgroundColor = 'rgba(46, 204, 113, 0.1)';
            });
            
            fileDropArea.addEventListener('dragleave', () => {
                fileDropArea.style.borderColor = '#fdbb2d';
                fileDropArea.style.backgroundColor = '';
            });
            
            fileDropArea.addEventListener('drop', (e) => {
                e.preventDefault();
                fileDropArea.style.borderColor = '#fdbb2d';
                fileDropArea.style.backgroundColor = '';
                
                if (e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    handleFileSelect();
                }
            });
            
            // 按钮事件
            connectBtn.addEventListener('click', connectToServer);
            sendBtn.addEventListener('click', startSending);
            stopBtn.addEventListener('click', stopSending);
            
            // 块大小选择
            chunkSizeSelect.addEventListener('change', () => {
                chunkSize = parseInt(chunkSizeSelect.value);
                addLog(`数据块大小设置为: ${chunkSize} 字节`, 'info');
            });
            
            // 初始块大小
            chunkSize = parseInt(chunkSizeSelect.value);
            
            addLog('应用程序初始化完成', 'info');
        }
        
        // 处理文件选择
        function handleFileSelect() {
            if (fileInput.files.length === 0) return;
            
            audioFile = fileInput.files[0];
            
            // 验证文件类型
            if (!audioFile.name.toLowerCase().endsWith('.wav')) {
                addLog('错误：请选择WAV格式的音频文件', 'error');
                return;
            }
            
            // 显示文件信息
            fileSize = audioFile.size;
            const fileSizeKB = (fileSize / 1024).toFixed(2);
            const fileName = audioFile.name;
            
            fileInfo.innerHTML = `
                <strong>${fileName}</strong> | ${fileSizeKB} KB<br>
                16kHz 单声道 WAV
            `;
            
            fileSizeDisplay.textContent = `${fileSizeKB} KB`;
            bytesSent = 0;
            packetCounter = 0;
            updateProgress();
            
            connectBtn.disabled = false;
            addLog(`已选择文件: ${fileName} (${fileSizeKB} KB)`, 'success');
        }
        
        // 连接到服务器
        function connectToServer() {
            const url = serverUrlInput.value;
            
            if (!url) {
                addLog('错误：请输入WebSocket服务器地址', 'error');
                return;
            }
            
            addLog(`正在连接到服务器: ${url}`, 'info');
            updateConnectionStatus('connecting', '连接中...');
            
            try {
                websocket = new WebSocket(url);
                
                websocket.onopen = () => {
                    updateConnectionStatus('connected', '已连接');
                    addLog('成功连接到服务器', 'success');
                    
                    sendBtn.disabled = false;
                    stopBtn.disabled = false;
                };
                
                websocket.onclose = () => {
                    updateConnectionStatus('disconnected', '已断开');
                    addLog('服务器连接已关闭', 'warning');
                    
                    sendBtn.disabled = true;
                    stopBtn.disabled = true;
                };
                
                websocket.onerror = (error) => {
                    updateConnectionStatus('error', '连接错误');
                    addLog(`WebSocket错误: ${error}`, 'error');
                };
                
                // 修改点：增强消息处理逻辑
                websocket.onmessage = (event) => {
                    try {
                        let response;
                        
                        // 处理不同类型的消息
                        if (typeof event.data === 'string') {
                            // 文本消息
                            response = event.data;
                        } else if (event.data instanceof ArrayBuffer) {
                            // ArrayBuffer消息
                            const decoder = new TextDecoder('utf-8');
                            response = decoder.decode(event.data);
                        } else if (event.data instanceof Blob) {
                            // Blob消息
                            const reader = new FileReader();
                            reader.onload = () => {
                                serverResponse.textContent = reader.result;
                                addLog(`收到服务器响应: ${reader.result}`, 'info');
                            };
                            reader.readAsText(event.data);
                            return;
                        } else {
                            // 其他类型消息
                            response = JSON.stringify(event.data);
                        }
                        
                        serverResponse.textContent = response;
                        addLog(`收到服务器响应: ${response}`, 'info');
                    } catch (e) {
                        addLog(`处理服务器响应时出错: ${e.message}`, 'error');
                    }
                };
                
            } catch (error) {
                updateConnectionStatus('error', '连接失败');
                addLog(`连接失败: ${error.message}`, 'error');
            }
        }
        
        // 开始发送文件
        function startSending() {
            if (!websocket || websocket.readyState !== WebSocket.OPEN) {
                addLog('错误：未连接到服务器', 'error');
                return;
            }
            
            if (!audioFile) {
                addLog('错误：请先选择WAV文件', 'error');
                return;
            }
            
            isSending = true;
            bytesSent = 0;
            packetCounter = 0;
            updateProgress();
            
            addLog('开始发送WAV文件数据...', 'info');
            
            // 创建FileReader读取文件
            fileReader = new FileReader();
            
            // 读取文件切片
            function readChunk(start) {
                if (!isSending) return;
                
                const end = Math.min(start + chunkSize, fileSize);
                const slice = audioFile.slice(start, end);
                
                fileReader.onload = (e) => {
                    if (isSending && websocket.readyState === WebSocket.OPEN) {
                        // 跳过WAV文件头（前44字节）
                        let data = e.target.result;
                        if (start === 0 && fileSize > fileHeaderSize) {
                            data = data.slice(fileHeaderSize);
                        }
                        
                        websocket.send(data);
                        
                        bytesSent += (end - start);
                        packetCounter++;
                        updateProgress();
                        
                        // 继续读取下一块
                        if (end < fileSize) {
                            readChunk(end);
                        } else {
                            addLog('文件发送完成', 'success');
                            isSending = false;
                        }
                    }
                };
                
                fileReader.readAsArrayBuffer(slice);
            }
            
            // 开始读取第一块
            readChunk(0);
        }
        
        // 停止发送
        function stopSending() {
            isSending = false;
            addLog('文件发送已停止', 'warning');
        }
        
        // 更新进度
        function updateProgress() {
            const percent = fileSize > 0 ? Math.min(100, (bytesSent / fileSize) * 100) : 0;
            
            progressBar.style.width = `${percent}%`;
            progressValue.textContent = `${percent.toFixed(1)}%`;
            
            const sentKB = (bytesSent / 1024).toFixed(2);
            const remainingKB = ((fileSize - bytesSent) / 1024).toFixed(2);
            
            sentSize.textContent = `${sentKB} KB`;
            remainingSize.textContent = `${remainingKB} KB`;
            packetCount.textContent = packetCounter;
        }
        
        // 添加日志
        function addLog(message, type = 'info') {
            const logEntry = document.createElement('div');
            logEntry.className = `log-entry ${type}`;
            logEntry.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
            logContainer.appendChild(logEntry);
            logContainer.scrollTop = logContainer.scrollHeight;
        }
        
        // 更新连接状态
        function updateConnectionStatus(status, text) {
            connectionStatus.textContent = text;
            connectionStatusValue.textContent = text;
            
            // 重置所有状态类
            statusIndicator.className = 'status-indicator';
            
            // 添加当前状态类
            switch (status) {
                case 'connected':
                    statusIndicator.classList.add('status-connected');
                    break;
                case 'disconnected':
                    statusIndicator.classList.add('status-disconnected');
                    break;
                case 'connecting':
                    statusIndicator.classList.add('status-connecting');
                    break;
                case 'error':
                    statusIndicator.classList.add('status-disconnected');
                    break;
            }
        }
        
        // 初始化应用
        window.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
